# LLM（OpenAI 或兼容网关；官方 OpenAI 可不填 BASE_URL，并将 JSON_RESPONSE_FORMAT 设为 true）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-3.5-turbo

# 主库 SQLAlchemy URL（与 config.yaml 中 database.main_db 对应；LLM 解析里的 connection 一般为 main_db）
# MySQL（默认端口 3306，把 your_db 换成实际库名）:
#   DATABASE_MAIN_URL=mysql+pymysql://用户名:密码@123.58.111.244:3306/your_db
# PostgreSQL（默认端口 5432）:
#   DATABASE_MAIN_URL=postgresql+psycopg2://用户名:密码@123.58.111.244:5432/your_db
# 密码中含 @ # / 等字符时需做 URL 编码，例如 @ -> %40
DATABASE_MAIN_URL=
# dream 库（与 config.yaml 中 database.dream 对应；LLM 解析 connection 填 dream）
DATABASE_DREAM_URL=

# 飞书
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=

# 企业微信
WECHAT_CORP_ID=
WECHAT_SECRET=
WECHAT_AGENT_ID=
